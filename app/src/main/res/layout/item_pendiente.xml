<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="231dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvIdEnvioT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: #"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRemitente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remitente: Nombre" />

        <TextView
            android:id="@+id/tvDestinatario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destinatario: Nombre" />

        <TextView
            android:id="@+id/tvDireccionOrigen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Origen: Dirección completa" />

        <TextView
            android:id="@+id/tvDireccionDestino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destino: Dirección completa" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnEntregado"
                android:layout_width="51dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:contentDescription="Entregado"
                android:visibility="visible"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/check" />

            <ImageButton
                android:id="@+id/btnNoEntregado"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@null"
                android:contentDescription="No Entregado"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/cerrar" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistorial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />



    </LinearLayout>

</androidx.cardview.widget.CardView>